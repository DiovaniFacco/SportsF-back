APP_NAME="Quadras API"
APP_ENV=local
APP_KEY=
# Manter false em qualquer ambiente acessível (staging/prod): com debug
# ligado a API vaza stack traces e paths do servidor nas respostas.
# Só use true no desenvolvimento local.
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=quadras_db
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@quadras.local"
MAIL_FROM_NAME="${APP_NAME}"

# Produção (Railway + Resend):
# MAIL_MAILER=resend
# RESEND_API_KEY=(painel Resend)
# MAIL_FROM_ADDRESS=no-reply@sfacco.com.br
# MAIL_FROM_NAME="SportsF"
# FRONTEND_URL=https://<front> (usado no link do e-mail de recuperação)
FRONTEND_URL=http://localhost:8081
RESEND_API_KEY=

SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Origens do front separadas por vírgula (+ *.sfacco.com.br via regex em config/cors.php)
CORS_ALLOWED_ORIGINS=http://localhost:8081

SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# Upload de imagens (Cloudinary - obrigatório em prod)
# Pegue em https://console.cloudinary.com -> Dashboard -> API Environment variable
CLOUDINARY_URL=
# Alternativa às credenciais individuais:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Em prod (Railway) APP_URL deve ser a URL pública do backend, ex:
# APP_URL=https://back-production-xxxx.up.railway.app
# E o front precisa de EXPO_PUBLIC_API_URL=https://back-production-xxxx.up.railway.app/api/v1
